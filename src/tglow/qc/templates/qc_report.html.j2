<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>TGlow QC report</title>
<script>{{ plotlyjs }}</script>
<style>
  :root { color-scheme: light dark; --tglow-accent: #0e9e86; }
  body { font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; margin: 0; padding: 0; }
  .page-head { position: sticky; top: 0; z-index: 100; }
  header { background: var(--tglow-accent); color: #fff; }
  header .inner { max-width: 1400px; margin: 0 auto; padding: 1rem 1.25rem; display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  header h1 { margin: 0; font-size: 1.3rem; }
  header .run-date { margin: 0; font-size: 0.85rem; opacity: 0.85; }
  nav { border-bottom: 1px solid #8884; background: Canvas; }
  nav .inner { max-width: 1400px; margin: 0 auto; padding: 0.5rem 1.25rem; display: flex; flex-wrap: wrap; gap: 0.25rem; }
  nav button { padding: 0.5rem 1rem; border: 1px solid #8884; border-radius: 6px; background: transparent; cursor: pointer; font-size: 0.95rem; }
  nav button.active { background: color-mix(in srgb, var(--tglow-accent) 25%, transparent); border-color: var(--tglow-accent); }
  main { max-width: 1400px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; box-sizing: border-box; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .metrics { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
  .metric { background: #8881; border-radius: 8px; padding: 0.6rem 1rem; min-width: 110px; }
  .metric .value { font-size: 1.15rem; font-weight: 600; }
  .metric .label { font-size: 0.72rem; opacity: 0.7; margin-top: 0.15rem; }
  .metric.hero { background: color-mix(in srgb, var(--tglow-accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--tglow-accent) 45%, transparent); }
  .metric.hero .value { font-size: 2.1rem; font-weight: 700; color: var(--tglow-accent); }
  .metric.hero .label { font-size: 0.85rem; opacity: 0.85; }
  .stats-box { background: rgba(136, 136, 136, 0.07); border: 1px solid rgba(136, 136, 136, 0.18); border-radius: 12px; padding: 1.1rem 1.25rem; margin-bottom: 1.5rem; }
  .stats-box .metrics { margin-bottom: 0.75rem; }
  .stats-box .metrics:last-child { margin-bottom: 0; }
  table.stats { border-collapse: collapse; width: 100%; }
  table.stats td { padding: 0.3rem 0.4rem; font-size: 0.85rem; border-bottom: 1px solid rgba(136, 136, 136, 0.18); }
  table.stats td.label { opacity: 0.7; }
  table.stats td:last-child { text-align: right; font-weight: 500; }
  table.stats tr:last-child td { border-bottom: none; }
  /* Tab 6 scaling warnings (scaling_warnings.tsv, written by calculate/consensus_scaling_factors) */
  .warn-box { background: rgba(220, 150, 30, 0.10); border: 1px solid rgba(220, 150, 30, 0.35); border-left-width: 4px; border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; }
  .warn-box h3 { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .warn-box-empty { background: rgba(136, 136, 136, 0.07); border-color: rgba(136, 136, 136, 0.25); }
  .warn-none { margin: 0; font-size: 0.85rem; opacity: 0.7; }
  /* Per-tab "Explanation" block - collapsed by default so the tab still opens on its data */
  .explain { border: 1px solid rgba(136, 136, 136, 0.28); border-radius: 8px; margin-bottom: 1.5rem; background: rgba(136, 136, 136, 0.05); }
  .explain > summary { cursor: pointer; padding: 0.55rem 0.9rem; font-weight: 600; font-size: 0.9rem; list-style: none; user-select: none; }
  .explain > summary::-webkit-details-marker { display: none; }
  .explain > summary::before { content: "\25B8"; display: inline-block; margin-right: 0.5rem; transition: transform 0.15s; opacity: 0.6; }
  .explain[open] > summary::before { transform: rotate(90deg); }
  .explain[open] > summary { border-bottom: 1px solid rgba(136, 136, 136, 0.22); }
  /* Capped measure for readability, centred in the block rather than left-aligned against it */
  .explain-body { padding: 0.9rem 1.1rem; font-size: 0.87rem; line-height: 1.55; max-width: 60rem; margin-inline: auto; }
  .explain-body > *:first-child { margin-top: 0; }
  .explain-body > *:last-child { margin-bottom: 0; }
  .explain-body ul, .explain-body ol { padding-left: 1.3rem; margin: 0.5rem 0; }
  .explain-body li { margin-bottom: 0.3rem; }
  table.warn-table td.warn-msg { text-align: left; font-weight: 400; font-size: 0.8rem; }
  table.warn-table th { text-align: left; padding: 0.3rem 0.4rem; font-size: 0.75rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.04em; }
  table.data-table { border-collapse: collapse; width: 100%; margin-bottom: 1.5rem; }
  table.data-table th, table.data-table td { padding: 0.4rem 0.6rem; font-size: 0.85rem; border-bottom: 1px solid rgba(136, 136, 136, 0.18); text-align: left; }
  table.data-table th { font-weight: 600; opacity: 0.8; }
  table.data-table th.sortable { cursor: pointer; user-select: none; }
  table.data-table th.sortable:hover { text-decoration: underline; }
  /* Well QC tab - a wide table (one column per checked channel), so it scrolls sideways rather than squeezing */
  .table-scroll { overflow-x: auto; margin-bottom: 1.5rem; }
  .table-scroll table.data-table { margin-bottom: 0; white-space: nowrap; }
  .verdict { font-weight: 600; }
  .verdict-fail { color: #d0453a; }
  .verdict-warn { color: #c98a0b; }
  .verdict-blacklisted { opacity: 0.6; }
  .metric.metric-fail .value { color: #d0453a; }
  .metric.metric-warn .value { color: #c98a0b; }
  .two-col { display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: wrap; }
  .two-col > div { flex: 1; min-width: 280px; }
  .two-col > .col-fixed { flex: 0 0 260px; }
  .tab-layout { display: flex; gap: 1.5rem; align-items: flex-start; }
  .tab-main { flex: 1 1 auto; min-width: 0; }
  .tab-sidebar {
    flex: 0 0 25%;
    min-width: 200px;
    box-sizing: border-box;
    position: sticky;
    top: calc(var(--header-height, 90px) + 1rem);
    align-self: flex-start;
    max-height: calc(100vh - var(--header-height, 90px) - 2rem);
    overflow-y: auto;
    border: 1px solid rgba(136, 136, 136, 0.4);
    border-radius: 10px;
    padding: 1rem;
  }
  .tab-sidebar select { width: 100%; margin: 0 0 1rem 0; box-sizing: border-box; }
  .tab-sidebar table.stats { margin-bottom: 1rem; }
  @media (max-width: 900px) {
    .tab-layout { flex-direction: column; }
    .tab-sidebar { position: static; flex: 1 1 auto; width: 100%; max-height: none; }
  }
  .grid { display: flex; flex-wrap: wrap; gap: 1rem; }
  /* Modifier, not a change to .grid itself - the flatfield tab's grid stays left-aligned */
  .grid-center { justify-content: center; }
  /* Two plates side by side on the intensity tab - they share a color scale, so the
     comparison only works when both are in view at once. minmax(0,1fr) lets the
     responsive Plotly divs shrink instead of forcing the row wider than the column. */
  .heatmap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .heatmap-grid > div { min-width: 0; }
  @media (max-width: 900px) { .heatmap-grid { grid-template-columns: 1fr; } }
  .grid-item { min-width: 320px; }
  select { padding: 0.3rem 0.6rem; font-size: 0.95rem; margin: 0 0.5rem 1rem 0; }
  .plate-block { display: none; }
  .plate-block.active { display: block; }
  .channel-block { display: none; }
  .channel-block.active { display: block; }
  .feature-block { display: none; }
  .feature-block.active { display: block; }
  img.qc-img { max-width: 100%; height: auto; border: 1px solid #8884; border-radius: 4px; }
  .missing { opacity: 0.6; font-style: italic; padding: 1rem; border: 1px dashed #8886; border-radius: 6px; display: inline-block; }
  .carousel { max-width: 900px; }
  .carousel-caption { opacity: 0.7; font-size: 0.9rem; margin-top: 0.35rem; }
  .carousel-controls { margin-top: 0.5rem; }
  .carousel-controls button { padding: 0.4rem 0.9rem; margin-right: 0.5rem; }
  h2 { margin-top: 0; }
  h3 { margin-top: 1.5rem; }
  footer.site-footer {
    max-width: 1400px; margin: 0 auto; padding: 1.5rem 1.25rem 2rem;
    display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
    border-top: 1px solid rgba(136, 136, 136, 0.25);
    font-size: 0.85rem; opacity: 0.85;
  }
  footer.site-footer img.footer-logo { height: 32px; width: auto; }
  footer.site-footer .footer-links { display: flex; gap: 1rem; }
  footer.site-footer .footer-links a { color: var(--tglow-accent); text-decoration: none; }
  footer.site-footer .footer-links a:hover { text-decoration: underline; }
  footer.site-footer .footer-version { margin-left: auto; opacity: 0.7; }
</style>
</head>
<body>

{# Collapsed-by-default "Explanation" block, one per tab. Uses <details> so it needs no JS
   and still prints/searches correctly when collapsed. Called as {% call explanation() %}. #}
{% macro explanation() %}
<details class="explain">
  <summary>Explanation</summary>
  <div class="explain-body">
{{ caller() }}
  </div>
</details>
{% endmacro %}

<div class="page-head">
  <header><div class="inner"><h1>TGlow QC report</h1><p class="run-date">Generated {{ generated_at }}</p></div></header>

  <nav><div class="inner">
    <button class="tab-btn active" data-tab="general">General QC</button>
  {% if well_qc.available %}
    <button class="tab-btn" data-tab="wellqc">Well QC</button>
  {% endif %}
  {% if registration.available %}
    <button class="tab-btn" data-tab="registration">Registration</button>
  {% endif %}
  {% if flatfield.available %}
    <button class="tab-btn" data-tab="flatfield">Flatfields</button>
  {% endif %}
  {% if decon.available %}
    <button class="tab-btn" data-tab="decon">Decon</button>
  {% endif %}
  {% if intensity.available %}
    <button class="tab-btn" data-tab="intensity">Intensities</button>
  {% endif %}
  {% if scaling.available %}
    <button class="tab-btn" data-tab="scaling">Scaling factors</button>
  {% endif %}
  {% if debris.available %}
    <button class="tab-btn" data-tab="debris">Debris</button>
  {% endif %}
  </div></nav>
</div>

<main>

<!-- ==================== Tab 1: General QC ==================== -->
<section id="tab-general" class="tab-content active">
  <h2>General QC</h2>
  {% call explanation() %}
  <p>A run-level summary of what was actually processed and segmented, intended as the first sanity
  check before looking at any of the other tabs. Every count here is derived from the per-cell and
  per-image measurements produced on the <em>unscaled</em> finalized images, so it reflects the data
  all downstream tabs are built from.</p>
  <ul>
    <li><strong>Cells</strong> and <strong>mean cells / well</strong> are the headline segmentation
    yield. A mean well below what the assay expects usually points at segmentation or focus problems
    rather than at the plating.</li>
    <li><strong>Images without cells</strong> counts fields where segmentation returned nothing. A
    handful is normal at plate edges; a large number is worth investigating.</li>
    <li><strong>Blacklisted wells</strong> are wells excluded up front by the blacklist file, not
    wells that failed any QC computed here.</li>
    <li><strong>Cycles</strong> is the number of imaging cycles merged into each final image. Anything
    other than 1 means registration ran, and the Registration tab applies.</li>
    {% if well_qc.available %}
    <li><strong>Failed wells</strong> and <strong>warned wells</strong> summarise the per-well QC verdicts;
    the Well QC tab lists which wells they are and which check tripped.</li>
    {% endif %}
  </ul>
  <p>The cells-per-well heatmaps show the spatial distribution of the segmentation yield across each
  plate. Read these for <em>patterns</em> rather than absolute numbers: edge effects, row or column
  gradients, and isolated dead wells are all far easier to see here than in the totals above.</p>
  {% endcall %}
  <div class="stats-box">
    <div class="metrics">
      <div class="metric hero"><div class="value">{{ general.stats.n_cells }}</div><div class="label">Cells</div></div>
      <div class="metric hero"><div class="value">{{ general.stats.mean_cells_per_well }}</div><div class="label">Mean cells / well</div></div>
    </div>
    <table class="stats">
      <tr><td class="label">Images</td><td>{{ general.stats.n_images }}</td></tr>
      <tr><td class="label">Plates</td><td>{{ general.stats.n_plates }}</td></tr>
      <tr><td class="label">Wells</td><td>{{ general.stats.n_wells }}</td></tr>
      <tr><td class="label">Fields / well</td><td>{{ general.stats.fields_per_well }}</td></tr>
      <tr><td class="label">Blacklisted wells</td><td>{{ general.stats.n_blacklisted_wells }}</td></tr>
      <tr><td class="label">Images without cells</td><td>{{ general.stats.n_images_without_cells }}</td></tr>
      <tr><td class="label">Cycles</td><td>{{ general.stats.n_cycles if general.stats.n_cycles is not none else "n/a" }}</td></tr>
      {% if well_qc.available %}
      <tr><td class="label">Failed wells</td><td class="{{ 'verdict verdict-fail' if well_qc.counts.fail else '' }}">{{ well_qc.counts.fail }}</td></tr>
      <tr><td class="label">Warned wells</td><td class="{{ 'verdict verdict-warn' if well_qc.counts.warn else '' }}">{{ well_qc.counts.warn }}</td></tr>
      {% endif %}
    </table>
  </div>

  <h3>Cells per well</h3>
  <div class="grid grid-center">
  {% for plate, html in general.cells_per_well_html.items() %}
    <div class="grid-item">{{ html | safe }}</div>
  {% endfor %}
  </div>
</section>

<!-- ==================== Well QC ==================== -->
{% if well_qc.available %}
<section id="tab-wellqc" class="tab-content">
  <h2>Well QC</h2>
  {% call explanation() %}
  <p>One row per well, with the value behind each check and a single verdict - the same table as
  <code>rr__qc/well_qc.tsv</code>, which is the one to filter on in a downstream analysis. The verdict
  takes the worst outcome of any check (blacklisted &gt; fail &gt; warn &gt; pass), and
  <code>qc_flags</code> names every check that tripped.</p>
  <ul>
    <li><strong>n_cells</strong> fails a well with fewer segmented cells than
    <code>qc_min_cells_per_well</code>, whatever the reason - seeding, focus or segmentation.</li>
    <li><strong>pct_registered</strong> fails a well when fewer than <code>qc_min_pct_registered</code>
    percent of its cells clear the registration threshold. Blank in a single-cycle run.</li>
    <li><strong>missing_cycles</strong> fails a well that was not imaged in every cycle of its
    registration group; it lists the plates it is missing from. Such a well cannot be registered, so it
    otherwise silently drops out of the run.</li>
    <li><strong>not_measured</strong> fails a well that was imaged in every cycle but has no
    measurements, e.g. a task that failed and was ignored.</li>
    <li><strong>pct_low_ch&lt;N&gt;</strong> warns when more than <code>qc_max_pct_low_signal</code>
    percent of a well's cells sit close to their field's background in that channel. Warn-only, since a
    dim channel is often real biology (a marker genuinely absent in that well).</li>
  </ul>
  <p>Blacklisted wells were excluded before anything was measured, so they carry no metrics.</p>
  {% endcall %}
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <select id="wellqc-verdict-select" onchange="filterWellQc(this.value)">
        <option value="all">All wells ({{ well_qc.n_wells }})</option>
      {% for verdict, n in well_qc.counts.items() %}
        <option value="{{ verdict }}">{{ verdict | capitalize }} ({{ n }})</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      <div class="stats-box">
        <div class="metrics">
          <div class="metric hero metric-fail"><div class="value">{{ well_qc.counts.fail }}</div><div class="label">Failed wells</div></div>
          <div class="metric hero metric-warn"><div class="value">{{ well_qc.counts.warn }}</div><div class="label">Warned wells</div></div>
          <div class="metric hero"><div class="value">{{ well_qc.counts.pass }}</div><div class="label">Passed wells</div></div>
        </div>
        <table class="stats">
          <tr><td class="label">Blacklisted wells</td><td>{{ well_qc.counts.blacklisted }}</td></tr>
          <tr><td class="label">Total wells</td><td>{{ well_qc.n_wells }}</td></tr>
        </table>
      </div>

      <div class="table-scroll">
      <table class="data-table" id="wellqc-table">
        <thead>
          <tr>
          {% for col in well_qc.columns %}
            <th class="sortable" onclick="sortTable(this.closest('table'), {{ loop.index0 }}, '{{ 'number' if col.numeric else 'string' }}')">{{ col.name }}</th>
          {% endfor %}
          </tr>
        </thead>
        <tbody>
        {% for row in well_qc.rows %}
          <tr data-verdict="{{ row.verdict }}">
          {% for display, sort_key in row.cells %}
            {% if well_qc.columns[loop.index0].name == "qc_verdict" %}
            <td data-sort="{{ sort_key }}" class="verdict verdict-{{ display }}">{{ display }}</td>
            {% else %}
            <td data-sort="{{ sort_key }}">{{ display }}</td>
            {% endif %}
          {% endfor %}
          </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 2: Registration ==================== -->
{% if registration.available %}
<section id="tab-registration" class="tab-content">
  <h2>Registration</h2>
  {% call explanation() %}
  <p>When a run images the same plate over several cycles, the cycles have to be aligned before their
  channels can be merged into one image. Alignment is estimated per field by phase cross-correlation
  between the reference cycle's registration channel and the query cycle's, and applied as a
  translation (no rotation or scaling).</p>
  <p>Registration quality is then evaluated per cell as the Pearson correlation between the reference
  and query registration channels over that cell's pixels. The idea is that a well-aligned cell has
  the same structure in both cycles, so the two channels correlate; a misaligned one does not. Cells
  whose correlation falls below <code>sc_registration_thresh</code> are dropped from the measurements
  feeding the Intensities and Scaling tabs, so poor registration shows up here as data loss rather
  than as silently wrong intensities.</p>
  <p>The density plot shows the distribution of that correlation with the threshold marked. A single
  peak well above the threshold is what you want. A second peak near zero means a subset of cells
  failed to align. The sample images show the worst and best aligning fields, so the failure mode can
  be judged by eye - a genuine misalignment looks like a visible offset between the two channels.</p>
  <p>Note this metric is only meaningful when the registration channels carry real structure; on
  channels that are mostly noise the correlation is low regardless of how good the alignment is.
  Generally, a nucleus stain should provide a good anchor, as the stain is reliable and bright and the
  nucleus shouldn't move excessively.</p>
  {% endcall %}
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in registration.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      {% if registration.density_html %}{{ registration.density_html | safe }}{% endif %}
    </aside>

    <div class="tab-main">
      <div class="stats-box">
        <div class="metrics">
          <div class="metric hero"><div class="value">{{ registration.stats.n_qced_cells }}</div><div class="label">Qc'ed cells ({{ registration.stats.pct_qced }}%)</div></div>
        </div>
        <table class="stats">
          <tr><td class="label">Total cells</td><td>{{ registration.stats.n_total_cells }}</td></tr>
        </table>
      </div>

      {# Worst first - a bad alignment is what you open this tab to find. #}
      {% for group, label in [("worst", "Worst aligning fields"), ("best", "Best aligning fields")] %}
      <h3>{{ label }}</h3>
      {% set images = registration["sample_images_" ~ group] %}
      {% if images %}
      <div class="carousel" id="reg-carousel-{{ group }}">
        {# src/caption are filled in by regCarousel below rather than inlined here - the
           data URI is already in regImages, and inlining it again doubles the bytes for
           every carousel's first image. #}
        <img class="qc-img" id="reg-carousel-img-{{ group }}" alt="">
        <div class="carousel-caption" id="reg-carousel-caption-{{ group }}"></div>
        <div class="carousel-controls">
          <button onclick="regCarousel('{{ group }}', -1)">&larr; Prev</button>
          <button onclick="regCarousel('{{ group }}', 1)">Next &rarr;</button>
        </div>
      </div>
      {% else %}
      <div class="missing">No {{ label|lower }} available (rg_plot may be disabled, no registration images were found, or no field had at least {{ registration.params.qc_min_cells_registration }} cells)</div>
      {% endif %}
      {% endfor %}
      <script>
        const regImages = {
        {% for group in ["worst", "best"] %}
          {{ group }}: [
          {% for img in registration["sample_images_" ~ group] %}
            {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
          {% endfor %}
          ],
        {% endfor %}
        };
        const regIdx = {};
        function regCarousel(group, delta) {
          const images = regImages[group];
          if (!images || !images.length) return;
          const next = ((regIdx[group] || 0) + delta + images.length) % images.length;
          regIdx[group] = next;
          document.getElementById('reg-carousel-img-' + group).src = images[next].src;
          document.getElementById('reg-carousel-caption-' + group).textContent = images[next].caption + ' (' + (next + 1) + ' / ' + images.length + ')';
        }
        // Render each carousel's first image - delta 0 leaves the index alone
        Object.keys(regImages).forEach(group => regCarousel(group, 0));
      </script>
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 3: Flatfields ==================== -->
{% if flatfield.available %}
<section id="tab-flatfield" class="tab-content">
  <h2>Flatfields</h2>
  {% call explanation() %}
  <p>Illumination across a field of view is never uniform - the centre is typically brighter than the
  corners, due to the optics rather than the biology. Left uncorrected this becomes a position-dependent
  intensity bias: the same cell measures differently depending on where in the field it happened to
  land, which adds variance to every intensity feature and can masquerade as a real effect.</p>
  <p>A flatfield model is fitted per plate and channel with a polynomial function or using BaSiCPy,
  which estimates the smooth illumination profile shared across many images. Cell masks are supplied
  as fitting weights so the model is driven by the illumination pattern rather than by where the cells
  are. Each image is then divided by its channel's flatfield before anything else is measured.
  Darkfields are shown, but currently not fitted, so will always produce a uniform image.</p>
  <p>The <strong>flatfield</strong> panel shows the fitted profile: expect something smooth and
  low-contrast, usually brighter in the middle. Sharp edges, or structure that looks like cells, mean
  the fit has absorbed signal it should not have - which would then be divided out of the real data.
  Also make note of the color scale of the flatfield: in the absence of a strong flatfield the pattern
  may look random, but if the scale is very low it may be better to either tweak or skip the
  estimation procedure. The <strong>evaluation</strong> panel shows the effect of applying it, for
  checking that the correction flattens the field without introducing new artefacts. You expect a
  horizontal line after correction, i.e. there is no relationship between the flatfield and the
  corrected image's intensity.</p>
  {% endcall %}
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in flatfield.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="ff-channel-select" onchange="showBlock('ff', this.value)">
      {% for channel in flatfield.by_channel.keys() | sort %}
        <option value="{{ channel }}">{{ flatfield.channel_labels[channel] }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      {% for channel in flatfield.by_channel.keys() | sort %}
      {% set entries = flatfield.by_channel[channel] %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="ff" data-channel="{{ channel }}">
        <div class="grid">
        {% for entry in entries %}
          <div class="grid-item">
            <h3>{{ entry.label }}</h3>
            <p>Flatfield</p>
            {% if entry.flatfield_data_uri %}<img class="qc-img" src="{{ entry.flatfield_data_uri }}">{% else %}<div class="missing">Flatfield image not available</div>{% endif %}
            <p>Evaluation</p>
            {% if entry.evaluation_data_uri %}<img class="qc-img" src="{{ entry.evaluation_data_uri }}">{% else %}<div class="missing">Evaluation image not available</div>{% endif %}
          </div>
        {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 4: Decon ==================== -->
{% if decon.available %}
<section id="tab-decon" class="tab-content">
  <h2>Deconvolution</h2>
  {% call explanation() %}
  <p>Every microscope blurs what it images: a point source comes out spread over a small volume,
  described by that channel's point spread function (PSF). Deconvolution attempts to invert that
  blurring, recovering sharper structure and better-separated objects - which matters most for
  punctate stains, where blur merges neighbouring spots into one.</p>
  <p>This runs Richardson-Lucy deconvolution for <code>dc_niter</code> iterations against a
  per-channel measured PSF. Richardson-Lucy is iterative and does not converge to a fixed point:
  too few iterations leave the image blurred, too many amplify noise into speckle, introduce
  "ghosting" artefacts and can push intensities well beyond their original range. The iteration count
  is therefore a genuine quality/noise trade-off rather than a setting to maximise.</p>
  <p>The before/after pairs are there to judge that trade-off by eye. Look for structure becoming
  crisper and objects separating, and against a grainy or "pitted" background, ringing around bright
  objects, or dim features disappearing - all signs of over-deconvolution. Note deconvolution changes
  absolute intensities, so it runs before scaling and before any intensity is measured.</p>
  <p>To ensure no values are clipped, deconvolution produces 32-bit float images, but these are too
  costly to save as is. So currently the deconvolution result is rescaled against a constant value for
  all images (<code>dc_clip_max</code>, defaults to 5&times;65535). This means the raw intensities and the
  deconvoluted intensities will vary by that factor, trading a bit of dynamic range for the storage
  efficiency of 16-bit uint.</p>
  {% endcall %}
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in decon.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="decon-channel-select" onchange="showBlock('decon', this.value)">
      {% for channel in decon.channels %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      {% for channel in decon.channels %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="decon" data-channel="{{ channel }}">
        <h3>Before / after (max projected, registration-merged)</h3>
        {% if decon.before_after.get(channel) %}
        <div class="carousel" id="decon-carousel-{{ channel }}">
          {# Filled in by deconCarousel(channel, 0) - see the note on reg-carousel-img #}
          <img class="qc-img" id="decon-carousel-img-{{ channel }}" alt="">
          <div class="carousel-caption" id="decon-carousel-caption-{{ channel }}"></div>
          <div class="carousel-controls">
            <button onclick="deconCarousel({{ channel }}, -1)">&larr; Prev</button>
            <button onclick="deconCarousel({{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No before/after sample images available for this channel</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 5: Intensities ==================== -->
{% if intensity.available %}
<section id="tab-intensity" class="tab-content">
  <h2>(Unscaled) Intensities</h2>
  {% call explanation() %}
  <p>Per-cell intensity statistics measured on the <strong>unscaled</strong> finalized images - after
  flatfield correction, registration and any deconvolution, but deliberately <em>before</em> scaling.
  That ordering is the point of this tab: these are the numbers the scaling factors are derived from,
  so this is where the raw, uncorrected differences between plates are visible.</p>
  <p>Only cells passing registration QC are included, so this matches the population the scaling
  factors were computed over rather than everything that was segmented.</p>
  <p>The heatmaps show each statistic's spatial distribution per plate, and the distributions show its
  shape per channel. Worth looking for:</p>
  <ul>
    <li><strong>Plate-to-plate offsets</strong> in the distributions - the expected technical variation
    that the plate offsets are there to correct. Large offsets are normal; the Scaling tab shows
    whether they were corrected.</li>
    <li><strong>Spatial gradients</strong> within a plate, which plate offsets cannot fix, since they
    apply one factor per plate. These point back at flatfield or focus problems.</li>
    <li><strong>Saturation</strong> - a max statistic piling up against the top of the range means
    signal was clipped at acquisition, and no amount of scaling recovers it.</li>
    <li><strong>Bimodality</strong>, which usually means a subset of wells or fields behaved
    differently and is worth tracing before it propagates into the scaling factors.</li>
  </ul>
  {% endcall %}
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <select id="int-channel-select" onchange="showBlock('int-ch', this.value); syncIntensity();">
      {% for channel in intensity.channels %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
      <select id="int-feature-select" onchange="syncIntensity()">
      {% for feature in intensity.features %}
        <option value="{{ feature }}"{{ ' selected' if feature == intensity.default_feature else '' }}>{{ feature }}</option>
      {% endfor %}
      </select>

      {% for channel in intensity.channels %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="int-ch" data-channel="{{ channel }}">
        {% for feature in intensity.features %}
        <div class="feature-block{{ ' active' if feature == intensity.default_feature else '' }}" data-group="int-feat-{{ channel }}" data-channel="{{ feature }}">
          <h3>Distribution</h3>
          {{ intensity.distributions_html[channel][feature] | safe }}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </aside>

    <div class="tab-main">
      {% for channel in intensity.channels %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="int-ch" data-channel="{{ channel }}">
        {% for feature in intensity.features %}
        <div class="feature-block{{ ' active' if feature == intensity.default_feature else '' }}" data-group="int-feat-{{ channel }}" data-channel="{{ feature }}">
          <h3>Per-plate well-mean heatmaps</h3>
          <div class="heatmap-grid">
          {% for plate, html in intensity.heatmaps_html[channel][feature].items() %}
            <div>{{ html | safe }}</div>
          {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 6: Scaling factors ==================== -->
{% if scaling.available %}
<section id="tab-scaling" class="tab-content">
  <h2>Scaling factors</h2>
  {% call explanation() %}
  <p>Scaling aims to achieve several goals:</p>
  <ul>
    <li>Use the dynamic range of the 16-bit uint optimally, so tools like CellProfiler don't have
    issues with dim stains and the images don't need to be adjusted when viewing. Scaling particularly
    influences the texture features in CellProfiler: for dim stains, or timeseries where the data has a
    lot of dynamic range, the 255 intensity ranges can collapse the values into one or two bins, making
    the distributions of these features singular.</li>
    <li>Adjust the average intensity between plates to be the same. This is usually done on a set of
    control cells expected to have constant intensity, and aims to correct for technical differences in
    intensity signals.</li>
    <li>Soft thresholding of scaling in the background region. Background values tend to be constant
    regardless of the technical differences in intensity, hence the foreground signal may vary but the
    background may not. By scaling the whole image this would adjust the constant background signal,
    leading to min-intensity features incorrectly acquiring a batch signal. The soft thresholding step
    fits a sigmoid curve between the estimated background intensity and the estimated foreground
    intensity, and weighs the scaling accordingly. Background pixels are left untouched, foreground
    pixels are scaled, and values in the middle get a downweighted version of the scaling factor
    depending on their intensity and that plate's sigmoid.</li>
  </ul>
  <p>The scaling factors show how each plate is offset relative to each other, and how much it is
  scaled to fully utilize the dynamic range of the 16-bit uint. The sigmoid plot shows the soft
  threshold (y-axis) versus the intensity (x-axis). A y value of 0 indicates no scaling, a value of 1
  indicates the full scaling factor is applied at that intensity level.</p>
  {% endcall %}
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in scaling.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="sig-channel-select" onchange="showBlock('sig', this.value)">
      {% for channel in scaling.sigmoid_html.keys() | sort %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      {% if scaling.warnings_checked %}
      <div class="warn-box{{ ' warn-box-empty' if not scaling.warnings else '' }}">
        <h3>Warnings</h3>
        {% if scaling.warnings %}
        <table class="stats warn-table">
          <tr><th>Source</th><th>Category</th><th>Channel</th><th>Message</th></tr>
          {% for w in scaling.warnings %}
          <tr>
            <td class="label">{{ w.source }}</td>
            <td class="label">{{ w.category }}</td>
            <td class="label">{{ w.channel }}</td>
            <td class="warn-msg">{{ w.message }}</td>
          </tr>
          {% endfor %}
        </table>
        {% else %}
        <p class="warn-none">No warnings were raised while deriving the scaling factors.</p>
        {% endif %}
      </div>
      {% endif %}

      {{ scaling.barplot_html | safe }}

      <h3>Sigmoid curves</h3>
      {% for channel in scaling.sigmoid_html.keys() | sort %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="sig" data-channel="{{ channel }}">
        {{ scaling.sigmoid_html[channel] | safe }}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 7: Debris ==================== -->
{% if debris.available %}
<section id="tab-debris" class="tab-content">
  <h2>Debris</h2>
  {% call explanation() %}
  <p>Debris estimation is designed to aid in accurately estimating the background intensities for
  scaling, as well as being a general QC metric. Debris is defined as a non-background signal
  outside of the cell mask. The non-background is defined as follows:</p>
  <ol>
    <li>The cell region is masked</li>
    <li>A threshold (<code>Otsu_log</code>, <code>Otsu</code>, <code>MCE</code>) is applied to the non-cell image</li>
    <li>The ratio of the mean of the non-cell image and the threshold is calculated. The assumption
    being that the threshold value of an image with only background will be near the mean of the
    background image. A high ratio of threshold/mean-of-background indicates the presence of debris.</li>
  </ol>

  <p>Each image is then classified per channel into one of three groups:
  <strong>no debris</strong> (threshold/mean ratio &lt; {{ debris.ratio_min }} - the threshold sits
  close to the mean of the background suggesting there is no debris and thus the debris percentage
  is not to be trusted), <strong>debris</strong> (ratio &ge; {{ debris.ratio_min }} AND debris %
  &lt; {{ debris.debris_max_pct }} - a reliably measured, acceptable debris level), or
  <strong>unusually high debris</strong> (ratio &ge; {{ debris.ratio_min }} AND
  debris % &ge; {{ debris.debris_max_pct }} - a reliable ratio but an unusually high debris
  fraction, often a sign the background itself is anomalous rather than a genuine debris
  detection).</p>

  <p>Common reasons debris may be present:</p>
  <ul>
    <li>Actual biological debris from dead/dying cells, or contamination</li>
    <li>Too strict a mask, leaving rings around the cell</li>
    <li>Registration errors in subsequent cycles causing poor overlap of the cell mask and the signal</li>
  </ul>
  {% endcall %}

  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in debris.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="debris-channel-select" onchange="showBlock('debris', this.value)">
      {% for channel in debris.scatter_html.keys() | sort %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      <table class="data-table" id="debris-summary-table">
        <thead>
          <tr>
            <th class="sortable" onclick="sortTable(this.closest('table'), 0, 'number')">Channel</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 1, 'number')">Images</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 2, 'number')">No debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 3, 'number')">% no debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 4, 'number')">Debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 5, 'number')">% debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 6, 'number')">Unusually high debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 7, 'number')">% unusually high debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 8, 'number')">Mean debris %</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 9, 'number')">Mean threshold</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 10, 'number')">Mean background</th>
          </tr>
        </thead>
        <tbody>
        {% for row in debris.summary_table %}
          <tr>
            <td data-sort="{{ row.channel }}">{{ row.channel }}</td>
            <td data-sort="{{ row.n_total }}">{{ row.n_total }}</td>
            <td data-sort="{{ row.n_no_debris }}">{{ row.n_no_debris }}</td>
            <td data-sort="{{ row.pct_no_debris }}">{{ row.pct_no_debris }}%</td>
            <td data-sort="{{ row.n_debris }}">{{ row.n_debris }}</td>
            <td data-sort="{{ row.pct_debris }}">{{ row.pct_debris }}%</td>
            <td data-sort="{{ row.n_unusually_high_debris }}">{{ row.n_unusually_high_debris }}</td>
            <td data-sort="{{ row.pct_unusually_high_debris }}">{{ row.pct_unusually_high_debris }}%</td>
            <td data-sort="{{ row.mean_debris_pct if row.mean_debris_pct is not none else -1 }}">{{ row.mean_debris_pct if row.mean_debris_pct is not none else "n/a" }}</td>
            <td data-sort="{{ row.mean_threshold if row.mean_threshold is not none else -1 }}">{{ row.mean_threshold if row.mean_threshold is not none else "n/a" }}</td>
            <td data-sort="{{ row.mean_background if row.mean_background is not none else -1 }}">{{ row.mean_background if row.mean_background is not none else "n/a" }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

      <h3>Threshold/mean ratio vs debris %</h3>
      {% for channel in debris.scatter_html.keys() | sort %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="debris" data-channel="{{ channel }}">
        {{ debris.scatter_html[channel] | safe }}

        <h3>No debris (highest-ratio) examples</h3>
        {% if debris.sample_images_no_debris.get(channel) %}
        <div class="carousel" id="debris-carousel-no_debris-{{ channel }}">
          {# Filled in by debrisCarousel('no_debris', channel, 0) - see the note on reg-carousel-img #}
          <img class="qc-img" id="debris-carousel-img-no_debris-{{ channel }}" alt="">
          <div class="carousel-caption" id="debris-carousel-caption-no_debris-{{ channel }}"></div>
          <div class="carousel-controls">
            <button onclick="debrisCarousel('no_debris', {{ channel }}, -1)">&larr; Prev</button>
            <button onclick="debrisCarousel('no_debris', {{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No "no debris" sample images available for this channel</div>
        {% endif %}

        <h3>Unusually high debris examples</h3>
        {% if debris.sample_images_unusually_high_debris.get(channel) %}
        <div class="carousel" id="debris-carousel-unusually-high-debris-{{ channel }}">
          {# Filled in by debrisCarousel('unusually_high_debris', channel, 0) - see the note on reg-carousel-img #}
          <img class="qc-img" id="debris-carousel-img-unusually-high-debris-{{ channel }}" alt="">
          <div class="carousel-caption" id="debris-carousel-caption-unusually-high-debris-{{ channel }}"></div>
          <div class="carousel-controls">
            <button onclick="debrisCarousel('unusually_high_debris', {{ channel }}, -1)">&larr; Prev</button>
            <button onclick="debrisCarousel('unusually_high_debris', {{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No unusually-high-debris sample images available for this channel</div>
        {% endif %}

        <h3>Debris (highest-debris) examples</h3>
        {% if debris.sample_images_debris.get(channel) %}
        <div class="carousel" id="debris-carousel-debris-{{ channel }}">
          {# Filled in by debrisCarousel('debris', channel, 0) - see the note on reg-carousel-img #}
          <img class="qc-img" id="debris-carousel-img-debris-{{ channel }}" alt="">
          <div class="carousel-caption" id="debris-carousel-caption-debris-{{ channel }}"></div>
          <div class="carousel-controls">
            <button onclick="debrisCarousel('debris', {{ channel }}, -1)">&larr; Prev</button>
            <button onclick="debrisCarousel('debris', {{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No debris sample images available for this channel</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

</main>

<footer class="site-footer">
  {% if logo_data_uri %}<img class="footer-logo" src="{{ logo_data_uri }}" alt="TrynkaLab logo">{% endif %}
  <div class="footer-links">
    <a href="https://trynkalab.github.io" target="_blank" rel="noopener">TrynkaLab</a>
    <a href="https://trynkalab.github.io/software/tglow-pipeline/index.html" target="_blank" rel="noopener">Documentation</a>
  </div>
  <div class="footer-version">tglow-pipeline {{ pipeline_version }}</div>
</footer>

<script>
  function syncHeaderHeight() {
    const head = document.querySelector('.page-head');
    if (head) document.documentElement.style.setProperty('--header-height', head.offsetHeight + 'px');
  }
  syncHeaderHeight();
  window.addEventListener('load', syncHeaderHeight);
  window.addEventListener('resize', syncHeaderHeight);

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      window.dispatchEvent(new Event('resize'));
    });
  });

  function showBlock(group, channel) {
    document.querySelectorAll('[data-group="' + group + '"]').forEach(el => {
      el.classList.toggle('active', el.dataset.channel === channel);
    });
    window.dispatchEvent(new Event('resize'));
  }

  function syncIntensity() {
    const channel = document.getElementById('int-channel-select').value;
    const feature = document.getElementById('int-feature-select').value;
    showBlock('int-feat-' + channel, feature);
  }

  {% if decon.available %}
  const deconImages = {
  {% for channel, images in decon.before_after.items() %}
    {{ channel }}: [
    {% for img in images %}
      {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
    {% endfor %}
    ],
  {% endfor %}
  };
  const deconIdx = {};
  function deconCarousel(channel, delta) {
    const images = deconImages[channel];
    if (!images || !images.length) return;
    const next = ((deconIdx[channel] || 0) + delta + images.length) % images.length;
    deconIdx[channel] = next;
    document.getElementById('decon-carousel-img-' + channel).src = images[next].src;
    document.getElementById('decon-carousel-caption-' + channel).textContent = images[next].caption + ' (' + (next + 1) + ' / ' + images.length + ')';
  }
  // Render each carousel's first image - delta 0 leaves the index alone. Channels with
  // no images are skipped by the guard inside deconCarousel.
  Object.keys(deconImages).forEach(channel => deconCarousel(channel, 0));
  {% endif %}

  {% if debris.available %}
  const debrisImages = {
    no_debris: {
    {% for channel, images in debris.sample_images_no_debris.items() %}
      {{ channel }}: [
      {% for img in images %}
        {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
      {% endfor %}
      ],
    {% endfor %}
    },
    unusually_high_debris: {
    {% for channel, images in debris.sample_images_unusually_high_debris.items() %}
      {{ channel }}: [
      {% for img in images %}
        {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
      {% endfor %}
      ],
    {% endfor %}
    },
    debris: {
    {% for channel, images in debris.sample_images_debris.items() %}
      {{ channel }}: [
      {% for img in images %}
        {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
      {% endfor %}
      ],
    {% endfor %}
    },
  };
  const debrisIdx = {};
  function debrisCarousel(sampleClass, channel, delta) {
    const images = (debrisImages[sampleClass] || {})[channel];
    if (!images || !images.length) return;
    const key = sampleClass + '-' + channel;
    const next = ((debrisIdx[key] || 0) + delta + images.length) % images.length;
    debrisIdx[key] = next;
    document.getElementById('debris-carousel-img-' + sampleClass + '-' + channel).src = images[next].src;
    document.getElementById('debris-carousel-caption-' + sampleClass + '-' + channel).textContent = images[next].caption + ' (' + (next + 1) + ' / ' + images.length + ')';
  }
  Object.entries(debrisImages).forEach(([sampleClass, byChannel]) =>
    Object.keys(byChannel).forEach(channel => debrisCarousel(sampleClass, channel, 0)));
  {% endif %}

  function filterWellQc(verdict) {
    document.querySelectorAll('#wellqc-table tbody tr').forEach(tr => {
      tr.style.display = (verdict === 'all' || tr.dataset.verdict === verdict) ? '' : 'none';
    });
  }

  function sortTable(table, col, type) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);
    const asc = !(table.dataset.sortCol == col && table.dataset.sortDir === 'asc');

    rows.sort((a, b) => {
      let va = a.cells[col].dataset.sort ?? a.cells[col].textContent;
      let vb = b.cells[col].dataset.sort ?? b.cells[col].textContent;
      if (type === 'number') { va = parseFloat(va); vb = parseFloat(vb); }
      if (va < vb) return asc ? -1 : 1;
      if (va > vb) return asc ? 1 : -1;
      return 0;
    });

    rows.forEach(r => tbody.appendChild(r));
    table.dataset.sortCol = col;
    table.dataset.sortDir = asc ? 'asc' : 'desc';
  }
</script>

</body>
</html>
