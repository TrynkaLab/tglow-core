<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>TGlow QC report</title>
<script>{{ plotlyjs }}</script>
<style>
  :root { color-scheme: light dark; --tglow-accent: #0e9e86; }
  body { font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; margin: 0; padding: 0; }
  .page-head { position: sticky; top: 0; z-index: 100; }
  header { background: var(--tglow-accent); color: #fff; }
  header .inner { max-width: 1400px; margin: 0 auto; padding: 1rem 1.25rem; display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  header h1 { margin: 0; font-size: 1.3rem; }
  header .run-date { margin: 0; font-size: 0.85rem; opacity: 0.85; }
  nav { border-bottom: 1px solid #8884; background: Canvas; }
  nav .inner { max-width: 1400px; margin: 0 auto; padding: 0.5rem 1.25rem; display: flex; flex-wrap: wrap; gap: 0.25rem; }
  nav button { padding: 0.5rem 1rem; border: 1px solid #8884; border-radius: 6px; background: transparent; cursor: pointer; font-size: 0.95rem; }
  nav button.active { background: color-mix(in srgb, var(--tglow-accent) 25%, transparent); border-color: var(--tglow-accent); }
  main { max-width: 1400px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; box-sizing: border-box; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .metrics { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
  .metric { background: #8881; border-radius: 8px; padding: 0.6rem 1rem; min-width: 110px; }
  .metric .value { font-size: 1.15rem; font-weight: 600; }
  .metric .label { font-size: 0.72rem; opacity: 0.7; margin-top: 0.15rem; }
  .metric.hero { background: color-mix(in srgb, var(--tglow-accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--tglow-accent) 45%, transparent); }
  .metric.hero .value { font-size: 2.1rem; font-weight: 700; color: var(--tglow-accent); }
  .metric.hero .label { font-size: 0.85rem; opacity: 0.85; }
  .stats-box { background: rgba(136, 136, 136, 0.07); border: 1px solid rgba(136, 136, 136, 0.18); border-radius: 12px; padding: 1.1rem 1.25rem; margin-bottom: 1.5rem; }
  .stats-box .metrics { margin-bottom: 0.75rem; }
  .stats-box .metrics:last-child { margin-bottom: 0; }
  table.stats { border-collapse: collapse; width: 100%; }
  table.stats td { padding: 0.3rem 0.4rem; font-size: 0.85rem; border-bottom: 1px solid rgba(136, 136, 136, 0.18); }
  table.stats td.label { opacity: 0.7; }
  table.stats td:last-child { text-align: right; font-weight: 500; }
  table.stats tr:last-child td { border-bottom: none; }
  table.data-table { border-collapse: collapse; width: 100%; margin-bottom: 1.5rem; }
  table.data-table th, table.data-table td { padding: 0.4rem 0.6rem; font-size: 0.85rem; border-bottom: 1px solid rgba(136, 136, 136, 0.18); text-align: left; }
  table.data-table th { font-weight: 600; opacity: 0.8; }
  table.data-table th.sortable { cursor: pointer; user-select: none; }
  table.data-table th.sortable:hover { text-decoration: underline; }
  .two-col { display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: wrap; }
  .two-col > div { flex: 1; min-width: 280px; }
  .two-col > .col-fixed { flex: 0 0 260px; }
  .tab-layout { display: flex; gap: 1.5rem; align-items: flex-start; }
  .tab-main { flex: 1 1 auto; min-width: 0; }
  .tab-sidebar {
    flex: 0 0 25%;
    min-width: 200px;
    box-sizing: border-box;
    position: sticky;
    top: calc(var(--header-height, 90px) + 1rem);
    align-self: flex-start;
    max-height: calc(100vh - var(--header-height, 90px) - 2rem);
    overflow-y: auto;
    border: 1px solid rgba(136, 136, 136, 0.4);
    border-radius: 10px;
    padding: 1rem;
  }
  .tab-sidebar select { width: 100%; margin: 0 0 1rem 0; box-sizing: border-box; }
  .tab-sidebar table.stats { margin-bottom: 1rem; }
  @media (max-width: 900px) {
    .tab-layout { flex-direction: column; }
    .tab-sidebar { position: static; flex: 1 1 auto; width: 100%; max-height: none; }
  }
  .grid { display: flex; flex-wrap: wrap; gap: 1rem; }
  .grid-item { min-width: 320px; }
  select { padding: 0.3rem 0.6rem; font-size: 0.95rem; margin: 0 0.5rem 1rem 0; }
  .plate-block { display: none; }
  .plate-block.active { display: block; }
  .channel-block { display: none; }
  .channel-block.active { display: block; }
  .feature-block { display: none; }
  .feature-block.active { display: block; }
  img.qc-img { max-width: 100%; height: auto; border: 1px solid #8884; border-radius: 4px; }
  .missing { opacity: 0.6; font-style: italic; padding: 1rem; border: 1px dashed #8886; border-radius: 6px; display: inline-block; }
  .carousel { max-width: 900px; }
  .carousel-caption { opacity: 0.7; font-size: 0.9rem; margin-top: 0.35rem; }
  .carousel-controls { margin-top: 0.5rem; }
  .carousel-controls button { padding: 0.4rem 0.9rem; margin-right: 0.5rem; }
  h2 { margin-top: 0; }
  h3 { margin-top: 1.5rem; }
  footer.site-footer {
    max-width: 1400px; margin: 0 auto; padding: 1.5rem 1.25rem 2rem;
    display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
    border-top: 1px solid rgba(136, 136, 136, 0.25);
    font-size: 0.85rem; opacity: 0.85;
  }
  footer.site-footer img.footer-logo { height: 32px; width: auto; }
  footer.site-footer .footer-links { display: flex; gap: 1rem; }
  footer.site-footer .footer-links a { color: var(--tglow-accent); text-decoration: none; }
  footer.site-footer .footer-links a:hover { text-decoration: underline; }
  footer.site-footer .footer-version { margin-left: auto; opacity: 0.7; }
</style>
</head>
<body>

<div class="page-head">
  <header><div class="inner"><h1>TGlow QC report</h1><p class="run-date">Generated {{ generated_at }}</p></div></header>

  <nav><div class="inner">
    <button class="tab-btn active" data-tab="general">General QC</button>
  {% if registration.available %}
    <button class="tab-btn" data-tab="registration">Registration</button>
  {% endif %}
  {% if flatfield.available %}
    <button class="tab-btn" data-tab="flatfield">Flatfields</button>
  {% endif %}
  {% if decon.available %}
    <button class="tab-btn" data-tab="decon">Decon</button>
  {% endif %}
  {% if intensity.available %}
    <button class="tab-btn" data-tab="intensity">Intensities</button>
  {% endif %}
  {% if scaling.available %}
    <button class="tab-btn" data-tab="scaling">Scaling factors</button>
  {% endif %}
  {% if debris.available %}
    <button class="tab-btn" data-tab="debris">Debris</button>
  {% endif %}
  </div></nav>
</div>

<main>

<!-- ==================== Tab 1: General QC ==================== -->
<section id="tab-general" class="tab-content active">
  <h2>General QC</h2>
  <div class="stats-box">
    <div class="metrics">
      <div class="metric hero"><div class="value">{{ general.stats.n_cells }}</div><div class="label">Cells</div></div>
      <div class="metric hero"><div class="value">{{ general.stats.mean_cells_per_well }}</div><div class="label">Mean cells / well</div></div>
    </div>
    <table class="stats">
      <tr><td class="label">Images</td><td>{{ general.stats.n_images }}</td></tr>
      <tr><td class="label">Plates</td><td>{{ general.stats.n_plates }}</td></tr>
      <tr><td class="label">Wells</td><td>{{ general.stats.n_wells }}</td></tr>
      <tr><td class="label">Fields / well</td><td>{{ general.stats.fields_per_well }}</td></tr>
      <tr><td class="label">Blacklisted wells</td><td>{{ general.stats.n_blacklisted_wells }}</td></tr>
      <tr><td class="label">Images without cells</td><td>{{ general.stats.n_images_without_cells }}</td></tr>
      <tr><td class="label">Cycles</td><td>{{ general.stats.n_cycles if general.stats.n_cycles is not none else "n/a" }}</td></tr>
    </table>
  </div>

  <h3>Cells per well</h3>
  <div class="grid">
  {% for plate, html in general.cells_per_well_html.items() %}
    <div class="grid-item">{{ html | safe }}</div>
  {% endfor %}
  </div>
</section>

<!-- ==================== Tab 2: Registration ==================== -->
{% if registration.available %}
<section id="tab-registration" class="tab-content">
  <h2>Registration</h2>
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in registration.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      {% if registration.density_html %}{{ registration.density_html | safe }}{% endif %}
    </aside>

    <div class="tab-main">
      <div class="stats-box">
        <div class="metrics">
          <div class="metric hero"><div class="value">{{ registration.stats.n_qced_cells }}</div><div class="label">Qc'ed cells ({{ registration.stats.pct_qced }}%)</div></div>
        </div>
        <table class="stats">
          <tr><td class="label">Total cells</td><td>{{ registration.stats.n_total_cells }}</td></tr>
        </table>
      </div>

      <h3>Sample registration images</h3>
      {% if registration.sample_images %}
      <div class="carousel" id="reg-carousel">
        <img class="qc-img" id="reg-carousel-img" src="{{ registration.sample_images[0].data_uri }}">
        <div class="carousel-caption" id="reg-carousel-caption">{{ registration.sample_images[0].caption }} (1 / {{ registration.sample_images|length }})</div>
        <div class="carousel-controls">
          <button onclick="regCarousel(-1)">&larr; Prev</button>
          <button onclick="regCarousel(1)">Next &rarr;</button>
        </div>
      </div>
      <script>
        const regImages = [
        {% for img in registration.sample_images %}
          {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
        {% endfor %}
        ];
        let regIdx = 0;
        function regCarousel(delta) {
          regIdx = (regIdx + delta + regImages.length) % regImages.length;
          document.getElementById('reg-carousel-img').src = regImages[regIdx].src;
          document.getElementById('reg-carousel-caption').textContent = regImages[regIdx].caption + ' (' + (regIdx + 1) + ' / ' + regImages.length + ')';
        }
      </script>
      {% else %}
      <div class="missing">No registration sample images available (rg_plot may be disabled, or none were found)</div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 3: Flatfields ==================== -->
{% if flatfield.available %}
<section id="tab-flatfield" class="tab-content">
  <h2>Flatfields</h2>
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in flatfield.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="ff-channel-select" onchange="showBlock('ff', this.value)">
      {% for channel in flatfield.by_channel.keys() | sort %}
        <option value="{{ channel }}">{{ flatfield.channel_labels[channel] }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      {% for channel in flatfield.by_channel.keys() | sort %}
      {% set entries = flatfield.by_channel[channel] %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="ff" data-channel="{{ channel }}">
        <div class="grid">
        {% for entry in entries %}
          <div class="grid-item">
            <h3>{{ entry.label }}</h3>
            <p>Flatfield</p>
            {% if entry.flatfield_data_uri %}<img class="qc-img" src="{{ entry.flatfield_data_uri }}">{% else %}<div class="missing">Flatfield image not available</div>{% endif %}
            <p>Evaluation</p>
            {% if entry.evaluation_data_uri %}<img class="qc-img" src="{{ entry.evaluation_data_uri }}">{% else %}<div class="missing">Evaluation image not available</div>{% endif %}
          </div>
        {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 4: Decon ==================== -->
{% if decon.available %}
<section id="tab-decon" class="tab-content">
  <h2>Deconvolution</h2>
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in decon.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="decon-channel-select" onchange="showBlock('decon', this.value)">
      {% for channel in decon.channels %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      {% for channel in decon.channels %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="decon" data-channel="{{ channel }}">
        <h3>Before / after (max projected, registration-merged)</h3>
        {% if decon.before_after.get(channel) %}
        <div class="carousel" id="decon-carousel-{{ channel }}">
          <img class="qc-img" id="decon-carousel-img-{{ channel }}" src="{{ decon.before_after[channel][0].data_uri }}">
          <div class="carousel-caption" id="decon-carousel-caption-{{ channel }}">{{ decon.before_after[channel][0].caption }} (1 / {{ decon.before_after[channel]|length }})</div>
          <div class="carousel-controls">
            <button onclick="deconCarousel({{ channel }}, -1)">&larr; Prev</button>
            <button onclick="deconCarousel({{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No before/after sample images available for this channel</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 5: Intensities ==================== -->
{% if intensity.available %}
<section id="tab-intensity" class="tab-content">
  <h2>(Unscaled) Intensities</h2>
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <select id="int-channel-select" onchange="showBlock('int-ch', this.value); syncIntensity();">
      {% for channel in intensity.channels %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
      <select id="int-feature-select" onchange="syncIntensity()">
      {% for feature in intensity.features %}
        <option value="{{ feature }}"{{ ' selected' if feature == intensity.default_feature else '' }}>{{ feature }}</option>
      {% endfor %}
      </select>

      {% for channel in intensity.channels %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="int-ch" data-channel="{{ channel }}">
        {% for feature in intensity.features %}
        <div class="feature-block{{ ' active' if feature == intensity.default_feature else '' }}" data-group="int-feat-{{ channel }}" data-channel="{{ feature }}">
          <h3>Distribution</h3>
          {{ intensity.distributions_html[channel][feature] | safe }}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </aside>

    <div class="tab-main">
      {% for channel in intensity.channels %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="int-ch" data-channel="{{ channel }}">
        {% for feature in intensity.features %}
        <div class="feature-block{{ ' active' if feature == intensity.default_feature else '' }}" data-group="int-feat-{{ channel }}" data-channel="{{ feature }}">
          <h3>Per-plate well-mean heatmaps</h3>
          {% for plate, html in intensity.heatmaps_html[channel][feature].items() %}
            {{ html | safe }}
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 6: Scaling factors ==================== -->
{% if scaling.available %}
<section id="tab-scaling" class="tab-content">
  <h2>Scaling factors</h2>
  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in scaling.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="sig-channel-select" onchange="showBlock('sig', this.value)">
      {% for channel in scaling.sigmoid_html.keys() | sort %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      {{ scaling.barplot_html | safe }}

      <h3>Sigmoid curves</h3>
      {% for channel in scaling.sigmoid_html.keys() | sort %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="sig" data-channel="{{ channel }}">
        {{ scaling.sigmoid_html[channel] | safe }}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ==================== Tab 7: Debris ==================== -->
{% if debris.available %}
<section id="tab-debris" class="tab-content">
  <h2>Debris</h2>

  <div class="tab-layout">
    <aside class="tab-sidebar">
      <table class="stats">
      {% for key, value in debris.params.items() %}
        <tr><td class="label">{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </table>
      <select id="debris-channel-select" onchange="showBlock('debris', this.value)">
      {% for channel in debris.scatter_html.keys() | sort %}
        <option value="{{ channel }}">Channel {{ channel }}</option>
      {% endfor %}
      </select>
    </aside>

    <div class="tab-main">
      <p>Each image is classified per channel into one of three groups: <strong>no debris</strong> (threshold/mean ratio &lt; {{ debris.ratio_min }} - it is the debris <em>percentage</em> that can't be trusted here, not the image itself: the threshold sits too close to the background to reliably measure how much debris is present, so it's treated as having no measurable debris), <strong>debris</strong> (ratio &ge; {{ debris.ratio_min }} AND debris % &lt; {{ debris.debris_max_pct }} - a reliably measured, acceptable debris level), or <strong>uncertain</strong> (ratio &ge; {{ debris.ratio_min }} AND debris % &ge; {{ debris.debris_max_pct }} - a reliable ratio but an unusually high debris fraction, often a sign the background itself is anomalous rather than a genuine debris detection).</p>

      <table class="data-table" id="debris-summary-table">
        <thead>
          <tr>
            <th class="sortable" onclick="sortTable(this.closest('table'), 0, 'number')">Channel</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 1, 'number')">Images</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 2, 'number')">No debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 3, 'number')">% no debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 4, 'number')">Debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 5, 'number')">% debris</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 6, 'number')">Uncertain</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 7, 'number')">% uncertain</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 8, 'number')">Mean threshold</th>
            <th class="sortable" onclick="sortTable(this.closest('table'), 9, 'number')">Mean background</th>
          </tr>
        </thead>
        <tbody>
        {% for row in debris.summary_table %}
          <tr>
            <td data-sort="{{ row.channel }}">{{ row.channel }}</td>
            <td data-sort="{{ row.n_total }}">{{ row.n_total }}</td>
            <td data-sort="{{ row.n_untrustworthy }}">{{ row.n_untrustworthy }}</td>
            <td data-sort="{{ row.pct_untrustworthy }}">{{ row.pct_untrustworthy }}%</td>
            <td data-sort="{{ row.n_trustworthy }}">{{ row.n_trustworthy }}</td>
            <td data-sort="{{ row.pct_trustworthy }}">{{ row.pct_trustworthy }}%</td>
            <td data-sort="{{ row.n_uncertain }}">{{ row.n_uncertain }}</td>
            <td data-sort="{{ row.pct_uncertain }}">{{ row.pct_uncertain }}%</td>
            <td data-sort="{{ row.mean_threshold if row.mean_threshold is not none else -1 }}">{{ row.mean_threshold if row.mean_threshold is not none else "n/a" }}</td>
            <td data-sort="{{ row.mean_background if row.mean_background is not none else -1 }}">{{ row.mean_background if row.mean_background is not none else "n/a" }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

      <h3>Threshold/mean ratio vs debris %</h3>
      {% for channel in debris.scatter_html.keys() | sort %}
      <div class="channel-block{{ ' active' if loop.first else '' }}" data-group="debris" data-channel="{{ channel }}">
        {{ debris.scatter_html[channel] | safe }}

        <h3>Uncertain examples</h3>
        {% if debris.sample_images_uncertain.get(channel) %}
        <div class="carousel" id="debris-carousel-uncertain-{{ channel }}">
          <img class="qc-img" id="debris-carousel-img-uncertain-{{ channel }}" src="{{ debris.sample_images_uncertain[channel][0].data_uri }}">
          <div class="carousel-caption" id="debris-carousel-caption-uncertain-{{ channel }}">{{ debris.sample_images_uncertain[channel][0].caption }} (1 / {{ debris.sample_images_uncertain[channel]|length }})</div>
          <div class="carousel-controls">
            <button onclick="debrisCarousel('uncertain', {{ channel }}, -1)">&larr; Prev</button>
            <button onclick="debrisCarousel('uncertain', {{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No uncertain sample images available for this channel</div>
        {% endif %}

        <h3>Debris (highest-debris) examples</h3>
        {% if debris.sample_images_trustworthy.get(channel) %}
        <div class="carousel" id="debris-carousel-trustworthy-{{ channel }}">
          <img class="qc-img" id="debris-carousel-img-trustworthy-{{ channel }}" src="{{ debris.sample_images_trustworthy[channel][0].data_uri }}">
          <div class="carousel-caption" id="debris-carousel-caption-trustworthy-{{ channel }}">{{ debris.sample_images_trustworthy[channel][0].caption }} (1 / {{ debris.sample_images_trustworthy[channel]|length }})</div>
          <div class="carousel-controls">
            <button onclick="debrisCarousel('trustworthy', {{ channel }}, -1)">&larr; Prev</button>
            <button onclick="debrisCarousel('trustworthy', {{ channel }}, 1)">Next &rarr;</button>
          </div>
        </div>
        {% else %}
        <div class="missing">No debris sample images available for this channel</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

</main>

<footer class="site-footer">
  {% if logo_data_uri %}<img class="footer-logo" src="{{ logo_data_uri }}" alt="TrynkaLab logo">{% endif %}
  <div class="footer-links">
    <a href="https://trynkalab.github.io" target="_blank" rel="noopener">TrynkaLab</a>
    <a href="https://trynkalab.github.io/software/tglow-pipeline/index.html" target="_blank" rel="noopener">Documentation</a>
  </div>
  <div class="footer-version">tglow-pipeline {{ pipeline_version }}</div>
</footer>

<script>
  function syncHeaderHeight() {
    const head = document.querySelector('.page-head');
    if (head) document.documentElement.style.setProperty('--header-height', head.offsetHeight + 'px');
  }
  syncHeaderHeight();
  window.addEventListener('load', syncHeaderHeight);
  window.addEventListener('resize', syncHeaderHeight);

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      window.dispatchEvent(new Event('resize'));
    });
  });

  function showBlock(group, channel) {
    document.querySelectorAll('[data-group="' + group + '"]').forEach(el => {
      el.classList.toggle('active', el.dataset.channel === channel);
    });
    window.dispatchEvent(new Event('resize'));
  }

  function syncIntensity() {
    const channel = document.getElementById('int-channel-select').value;
    const feature = document.getElementById('int-feature-select').value;
    showBlock('int-feat-' + channel, feature);
  }

  {% if decon.available %}
  const deconImages = {
  {% for channel, images in decon.before_after.items() %}
    {{ channel }}: [
    {% for img in images %}
      {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
    {% endfor %}
    ],
  {% endfor %}
  };
  const deconIdx = {};
  function deconCarousel(channel, delta) {
    const images = deconImages[channel];
    if (!images || !images.length) return;
    const next = ((deconIdx[channel] || 0) + delta + images.length) % images.length;
    deconIdx[channel] = next;
    document.getElementById('decon-carousel-img-' + channel).src = images[next].src;
    document.getElementById('decon-carousel-caption-' + channel).textContent = images[next].caption + ' (' + (next + 1) + ' / ' + images.length + ')';
  }
  {% endif %}

  {% if debris.available %}
  const debrisImages = {
    uncertain: {
    {% for channel, images in debris.sample_images_uncertain.items() %}
      {{ channel }}: [
      {% for img in images %}
        {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
      {% endfor %}
      ],
    {% endfor %}
    },
    trustworthy: {
    {% for channel, images in debris.sample_images_trustworthy.items() %}
      {{ channel }}: [
      {% for img in images %}
        {src: {{ img.data_uri | tojson }}, caption: {{ img.caption | tojson }}},
      {% endfor %}
      ],
    {% endfor %}
    },
  };
  const debrisIdx = {};
  function debrisCarousel(sampleClass, channel, delta) {
    const images = (debrisImages[sampleClass] || {})[channel];
    if (!images || !images.length) return;
    const key = sampleClass + '-' + channel;
    const next = ((debrisIdx[key] || 0) + delta + images.length) % images.length;
    debrisIdx[key] = next;
    document.getElementById('debris-carousel-img-' + sampleClass + '-' + channel).src = images[next].src;
    document.getElementById('debris-carousel-caption-' + sampleClass + '-' + channel).textContent = images[next].caption + ' (' + (next + 1) + ' / ' + images.length + ')';
  }
  {% endif %}

  function sortTable(table, col, type) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);
    const asc = !(table.dataset.sortCol == col && table.dataset.sortDir === 'asc');

    rows.sort((a, b) => {
      let va = a.cells[col].dataset.sort ?? a.cells[col].textContent;
      let vb = b.cells[col].dataset.sort ?? b.cells[col].textContent;
      if (type === 'number') { va = parseFloat(va); vb = parseFloat(vb); }
      if (va < vb) return asc ? -1 : 1;
      if (va > vb) return asc ? 1 : -1;
      return 0;
    });

    rows.forEach(r => tbody.appendChild(r));
    table.dataset.sortCol = col;
    table.dataset.sortDir = asc ? 'asc' : 'desc';
  }
</script>

</body>
</html>
